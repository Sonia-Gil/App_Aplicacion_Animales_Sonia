<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <!--imagen superior de cabecera y ponerla circular -->
    <androidx.cardview.widget.CardView xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="70dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/imgInicioHeader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/imagen_sabana3" />

    </androidx.cardview.widget.CardView>


    <!-- titulo principal -->
    <TextView
        android:id="@+id/textoTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="Reino Animal"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- para los botones de categorias -->
    <Button
        android:id="@+id/btnMamiferos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Mamíferos" /><!-- es lo que se separan un boton del siguiente -->

    <Button
        android:id="@+id/btnAves"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="12dp"
        android:text="Aves" />

    <Button
        android:id="@+id/btnPeces"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="12dp"
        android:text="Peces" />


    <!-- boton de salir de la aplicación -->
    <Button
        android:id="@+id/btnSalir"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:backgroundTint="#757575"
        android:text="Salir de la aplicación" />

</LinearLayout>