<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    android:paddingTop="32dp">

    <!-- imagen de la categoría, pelos, plumas, escamas -->
    <ImageView
        android:id="@+id/imgCategoriaHeader"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:scaleType="fitCenter" />
    <!--android:scaleType="centerCrop"-->

    <!-- título de la categoría -->
    <TextView
        android:id="@+id/txtTituloCategoria"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- botón para añadir un animal directamente -->
    <Button
        android:id="@+id/btnAgregarAca"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Añadir animal a esta categoría"
        android:backgroundTint="#4CAF50"
        android:layout_marginBottom="8dp" />

    <!-- RecyclerView de la lista -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAnimales"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"/><!-- para el scroll en pantalla -->

    <!-- botón de volver al menú -->
    <Button
        android:id="@+id/btnVolverMenu"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="← Volver al Menú Principal"
        android:backgroundTint="#757575"
        android:layout_marginTop="8dp" />

</LinearLayout>